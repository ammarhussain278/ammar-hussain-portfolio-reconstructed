---
const { project, featured=false } = Astro.props;
---
<article class:list={["project-card", featured && "featured"]}>
  <a class="project-image" href={`/work/${project.slug}`} aria-label={`View ${project.title}`}>
    <img src={project.cover} alt={`${project.title} project preview`} loading="lazy" />
  </a>
  <div class="project-meta"><span>{project.category} / {project.year}</span><span>↗</span></div>
  <h3><a href={`/work/${project.slug}`}>{project.title}</a></h3>
  <p>{project.description}</p>
</article>
